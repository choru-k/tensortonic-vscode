{
  "name": "tensortonic-vscode",
  "displayName": "TensorTonic for VS Code (Unofficial)",
  "description": "TensorTonic study with a consented encrypted session, direct HTTPS Python Run/Submit, and optional browser presentation.",
  "version": "0.12.6",
  "publisher": "choru-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "tensortonic",
    "pytorch",
    "machine-learning",
    "practice"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:tensortonicProblems",
    "onLanguageModelTool:tensortonic_current_problem",
    "onStartupFinished",
    "onView:tensortonicStudyStatus"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TensorTonic writes study files and uses an explicitly saved website session for HTTPS reads."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Saved-session storage and the optional browser require a local VS Code desktop extension host."
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "python3 scripts/package.py",
    "test:transport": "node --test test/native-browser-bridge.test.js test/request-policy.test.js",
    "test:session": "node --test test/session-*.test.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tensortonic",
          "title": "TensorTonic",
          "icon": "media/tensortonic.svg"
        }
      ]
    },
    "views": {
      "tensortonic": [
        {
          "id": "tensortonicProblems",
          "name": "Study plan"
        },
        {
          "id": "tensortonicStudyStatus",
          "name": "Study status",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "tensortonic.connect",
        "title": "Connect session",
        "category": "TensorTonic",
        "icon": "$(plug)"
      },
      {
        "command": "tensortonic.disconnect",
        "title": "Clear saved session",
        "category": "TensorTonic",
        "icon": "$(sign-out)"
      },
      {
        "command": "tensortonic.openProblem",
        "title": "Open problem",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.previousProblem",
        "title": "Previous study-plan problem",
        "category": "TensorTonic",
        "icon": "$(arrow-left)",
        "enablement": "tensortonic.hasPrevious"
      },
      {
        "command": "tensortonic.nextProblem",
        "title": "Next study-plan problem",
        "category": "TensorTonic",
        "icon": "$(arrow-right)",
        "enablement": "tensortonic.hasNext"
      },
      {
        "command": "tensortonic.search",
        "title": "Search problems",
        "category": "TensorTonic",
        "icon": "$(search)"
      },
      {
        "command": "tensortonic.refresh",
        "title": "Refresh problems",
        "category": "TensorTonic",
        "icon": "$(refresh)"
      },
      {
        "command": "tensortonic.run",
        "title": "TensorTonic: Run public test cases",
        "category": "TensorTonic",
        "icon": "$(beaker)",
        "enablement": "tensortonic.gradingAvailable && !tensortonic.executing && !tensortonic.displayMismatch && !tensortonic.displayNavigating"
      },
      {
        "command": "tensortonic.submit",
        "title": "TensorTonic: Submit current solution",
        "category": "TensorTonic",
        "icon": "$(cloud-upload)",
        "enablement": "tensortonic.gradingAvailable && !tensortonic.executing && !tensortonic.displayMismatch && !tensortonic.displayNavigating"
      },
      {
        "command": "tensortonic.description",
        "title": "Show problem description",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.openTests",
        "title": "Edit test cases",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.openInBrowser",
        "title": "Open original problem in browser",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.chooseStudyPlan",
        "title": "Choose study plan",
        "category": "TensorTonic",
        "icon": "$(list-selection)"
      },
      {
        "command": "tensortonic.smokeTest",
        "title": "Check connection and problem access",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.openAgentContext",
        "title": "Open problem context for coding agents",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.discussWithAgent",
        "title": "Discuss problem with Agent",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.discussWithCodex",
        "title": "Attach problem and solution to Codex",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.showStudyPlan",
        "title": "Show study plan sidebar",
        "category": "TensorTonic",
        "icon": "$(book)"
      },
      {
        "command": "tensortonic.startStudying",
        "title": "Start studying",
        "category": "TensorTonic",
        "icon": "$(new-window)"
      },
      {
        "command": "tensortonic.changeStudyFolder",
        "title": "Start studying in another folder\u2026",
        "category": "TensorTonic",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tensortonic.interactiveExplanation",
        "title": "Open original interactive explanation",
        "category": "TensorTonic",
        "icon": "$(graph)"
      },
      {
        "command": "tensortonic.openOriginalInVSCode",
        "title": "Open original problem in VS Code",
        "category": "TensorTonic",
        "icon": "$(globe)"
      },
      {
        "command": "tensortonic.offlineExploration",
        "title": "Offline learning exploration",
        "category": "TensorTonic",
        "icon": "$(beaker)"
      },
      {
        "command": "tensortonic.setupStudyEnvironment",
        "title": "Set up study Python environment",
        "category": "TensorTonic",
        "icon": "$(add)"
      },
      {
        "command": "tensortonic.repairStudyEnvironment",
        "title": "Repair study Python environment",
        "category": "TensorTonic",
        "icon": "$(tools)"
      },
      {
        "command": "tensortonic.chooseProblemView",
        "title": "Choose problem view (Markdown / Web)",
        "category": "TensorTonic",
        "icon": "$(browser)"
      },
      {
        "command": "tensortonic.gradingStatus",
        "title": "Grading availability",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.nextUnsolved",
        "category": "TensorTonic",
        "title": "Next unsolved problem",
        "icon": "$(debug-step-over)",
        "enablement": "tensortonic.hasNextUnsolved"
      },
      {
        "command": "tensortonic.testsView",
        "category": "TensorTonic",
        "title": "Show tests",
        "icon": "$(checklist)"
      },
      {
        "command": "tensortonic.resultsView",
        "category": "TensorTonic",
        "title": "Show Run / Submit results",
        "icon": "$(output)"
      },
      {
        "command": "tensortonic.cancelExecution",
        "category": "TensorTonic",
        "title": "Cancel TensorTonic Run / Submit",
        "icon": "$(debug-stop)",
        "enablement": "tensortonic.executing"
      },
      {
        "command": "tensortonic.useStudyEnvironment",
        "title": "Use study Python environment",
        "category": "TensorTonic",
        "icon": "$(snake)"
      },
      {
        "command": "tensortonic.manageStudyPlans",
        "title": "Manage sidebar study plans",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.removeStudyPlan",
        "title": "Remove plan from sidebar",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.resumeStudyPlan",
        "title": "Resume study plan",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.discussSelectedFailure",
        "title": "Discuss a selected failed case",
        "category": "TensorTonic"
      },
      {
        "command": "tensortonic.toggleFocusMode",
        "title": "Focus mode / Original view",
        "category": "TensorTonic",
        "icon": "$(eye)"
      },
      {
        "command": "tensortonic.showStudyStatus",
        "title": "Show study status",
        "category": "TensorTonic",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tensortonic.previousProblem",
          "when": "view == tensortonicProblems && tensortonic.connected",
          "group": "navigation@1"
        },
        {
          "command": "tensortonic.nextProblem",
          "when": "view == tensortonicProblems && tensortonic.connected",
          "group": "navigation@2"
        },
        {
          "command": "tensortonic.nextUnsolved",
          "when": "view == tensortonicProblems && tensortonic.connected",
          "group": "navigation@3"
        },
        {
          "command": "tensortonic.connect",
          "when": "view == tensortonicProblems && !tensortonic.connected",
          "group": "navigation@1"
        },
        {
          "command": "tensortonic.chooseStudyPlan",
          "when": "view == tensortonicProblems",
          "group": "plans@1"
        },
        {
          "command": "tensortonic.search",
          "when": "view == tensortonicProblems",
          "group": "plans@2"
        },
        {
          "command": "tensortonic.refresh",
          "when": "view == tensortonicProblems && tensortonic.connected",
          "group": "plans@3"
        },
        {
          "command": "tensortonic.startStudying",
          "when": "view == tensortonicProblems",
          "group": "workspace@1"
        },
        {
          "command": "tensortonic.chooseProblemView",
          "when": "view == tensortonicProblems",
          "group": "workspace@2"
        },
        {
          "command": "tensortonic.disconnect",
          "when": "view == tensortonicProblems && (tensortonic.connected || tensortonic.cleanupPending)",
          "group": "connection@1"
        },
        {
          "command": "tensortonic.manageStudyPlans",
          "when": "view == tensortonicProblems",
          "group": "navigation@9"
        },
        {
          "command": "tensortonic.toggleFocusMode",
          "when": "view == tensortonicProblems",
          "group": "presentation@9"
        },
        {
          "command": "tensortonic.showStudyStatus",
          "when": "view == tensortonicProblems",
          "group": "workspace@3"
        }
      ],
      "view/item/context": [
        {
          "command": "tensortonic.openInBrowser",
          "when": "view == tensortonicProblems && viewItem == tensortonicProblem",
          "group": "navigation"
        },
        {
          "command": "tensortonic.interactiveExplanation",
          "when": "view == tensortonicProblems && viewItem == tensortonicProblem",
          "group": "navigation@2"
        },
        {
          "command": "tensortonic.offlineExploration",
          "when": "view == tensortonicProblems && viewItem == tensortonicProblem",
          "group": "learning@1"
        },
        {
          "command": "tensortonic.removeStudyPlan",
          "when": "view == tensortonicProblems && viewItem == tensortonicStudyPlan",
          "group": "management@1"
        },
        {
          "command": "tensortonic.resumeStudyPlan",
          "when": "view == tensortonicProblems && viewItem == tensortonicStudyPlan",
          "group": "management@2"
        },
        {
          "command": "tensortonic.toggleFocusMode",
          "when": "view == tensortonicStudyStatus && viewItem == tensortonicStatusFocus",
          "group": "inline"
        },
        {
          "command": "tensortonic.chooseProblemView",
          "when": "view == tensortonicStudyStatus && viewItem == tensortonicStatusProblemView",
          "group": "inline"
        },
        {
          "command": "tensortonic.setupStudyEnvironment",
          "when": "view == tensortonicStudyStatus && viewItem == tensortonicStatusEnvironmentCreate",
          "group": "inline"
        },
        {
          "command": "tensortonic.useStudyEnvironment",
          "when": "view == tensortonicStudyStatus && viewItem == tensortonicStatusEnvironmentUse",
          "group": "inline"
        },
        {
          "command": "tensortonic.repairStudyEnvironment",
          "when": "view == tensortonicStudyStatus && viewItem == tensortonicStatusEnvironmentRepair",
          "group": "inline"
        },
        {
          "command": "tensortonic.startStudying",
          "when": "view == tensortonicStudyStatus && viewItem == tensortonicStatusEnvironmentChoose",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "tensortonic.run",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources && !tensortonic.executing",
          "group": "navigation@91"
        },
        {
          "command": "tensortonic.submit",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources && !tensortonic.executing",
          "group": "navigation@92"
        },
        {
          "command": "tensortonic.cancelExecution",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources && tensortonic.executing && resource in tensortonic.executingResources",
          "group": "navigation@91"
        },
        {
          "command": "tensortonic.description",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@1"
        },
        {
          "command": "tensortonic.testsView",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@2"
        },
        {
          "command": "tensortonic.resultsView",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@3"
        },
        {
          "command": "tensortonic.interactiveExplanation",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@4"
        },
        {
          "command": "tensortonic.offlineExploration",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@5"
        },
        {
          "command": "tensortonic.openTests",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@6"
        },
        {
          "command": "tensortonic.openAgentContext",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@7"
        },
        {
          "command": "tensortonic.discussWithCodex",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "tensortonic@8"
        },
        {
          "command": "tensortonic.toggleFocusMode",
          "when": "resourceScheme == file && resource in tensortonic.solutionResources",
          "group": "presentation@9"
        }
      ]
    },
    "configuration": {
      "title": "TensorTonic",
      "properties": {
        "tensortonic.studyPlan": {
          "type": "string",
          "default": "pytorch-basics",
          "description": "Choose a study plan from the sidebar plan label or TensorTonic status bar. Manual slug/URL entry remains available in the picker; leave empty for free problems.",
          "scope": "window"
        },
        "tensortonic.solutionDirectory": {
          "type": "string",
          "default": "tensortonic",
          "description": "Relative folder inside the workspace for solution code and editable test cases.",
          "scope": "window"
        },
        "tensortonic.problemView": {
          "type": "string",
          "enum": [
            "markdown",
            "web"
          ],
          "default": "web",
          "enumDescriptions": [
            "Show the local formatted Markdown statement and math.",
            "Open the canonical original TensorTonic page in VS Code Integrated Browser beside the solution. Website login is separate."
          ],
          "description": "Default presentation for explicit problem opens, sidebar selection, and Previous/Next. Choose problem view command changes this workspace only when one is open. Description always opens Markdown.",
          "scope": "window"
        },
        "tensortonic.difficultyDisplay": {
          "type": "string",
          "enum": [
            "text",
            "color",
            "hidden"
          ],
          "default": "text",
          "description": "Difficulty in extension-owned UI: subtle text, themed color indicator, or hidden. Original website is unchanged."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "tensortonic_current_problem",
        "displayName": "Read current TensorTonic problem",
        "modelDescription": "Read the selected TensorTonic problem statement, constraints, public tests, and the current student code including unsaved editor changes. Use when discussing a TensorTonic exercise. Does not run, submit, or retrieve reference solutions.",
        "userDescription": "Read the current TensorTonic exercise and editor code for discussion.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "tensortonicProblem",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/choru-k/tensortonic-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/choru-k/tensortonic-vscode/issues"
  },
  "homepage": "https://github.com/choru-k/tensortonic-vscode#readme",
  "enabledApiProposals": [
    "browser"
  ],
  "icon": "media/tensortonic-icon.png"
}
